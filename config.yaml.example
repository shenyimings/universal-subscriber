# subscriber config
# source type:
#   rss     - RSS/Atom feed, fetch full text of each new entry
#   page    - watch a web page for content changes; summarize the diff
#   browser - render a JS page via Obscura, then diff like `page`

llm:
  provider: deepseek   # which profile below is active: deepseek | zai-coding-cn
  profiles:
    deepseek:
      base_url: https://api.deepseek.com
      api_key_env: DEEPSEEK_API_KEY
      model: deepseek-chat           # used for the daily digest (simple task, cheap model is fine)
      wiki_model: deepseek-reasoner  # used for wiki compilation; falls back to `model` if omitted
    zai-coding-cn:
      # GLM coding plan. Requests carry pi's User-Agent, since coding-plan keys
      # can be restricted to Pi Coding Agent.
      base_url: https://open.bigmodel.cn/api/coding/paas/v4
      api_key_env: GLM_API_KEY
      model: glm-5.3
      wiki_model: glm-5.3
      reasoning_effort: low  # ingest and wiki agent; glm-5.3 cannot turn thinking off (low/high/max)

email:
  to: you@example.com
  subject_prefix: "[Daily Digest]"

limits:
  max_items_per_source: 5   # max items summarized per source per run
  max_chars_per_item: 6000  # max characters of body text sent to the LLM

# wiki:
#   dir: wiki               # where archived sources and compiled pages live (default: wiki/)

sources:
  - name: Example RSS
    type: rss
    url: https://example.com/feed.xml

  - name: Example Page
    type: page
    url: https://example.com/blog

  # inbox: read received emails from an AgentMail inbox as a source.
  # Short URL-only messages are auto-fetched and extracted.
  - name: My Inbox
    type: inbox
    inbox_id: your-inbox@agentmail.to

  # browser: renders JS with Obscura, then diffs. `selector` is optional and
  # narrows the watched region on complex pages.
  - name: Example Browser Source
    type: browser
    url: https://example.com/dynamic-page
    selector: main
